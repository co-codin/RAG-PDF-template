# Copy to .env and fill in. Never commit .env.

# --- LLM (generation) ---------------------------------------------------------
LLM_PROVIDER=anthropic            # anthropic | fake (offline, deterministic)
ANTHROPIC_API_KEY=                # sk-ant-...
LLM_MODEL=claude-sonnet-5-5
# LLM_TEMPERATURE=                # leave unset for models that reject non-default temperature
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# --- Embeddings ---------------------------------------------------------------
EMBEDDINGS_PROVIDER=openai        # openai | ollama | hash (offline, lexical only)
OPENAI_API_KEY=                   # sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
HASH_EMBEDDING_DIM=512

# --- Retrieval / pipeline -----------------------------------------------------
RETRIEVAL_K=6
VECTOR_K=12
BM25_K=12
RRF_K=60
GRADER_MODE=llm                   # llm | heuristic | none
MIN_RELEVANT_DOCS=1
QUERY_REWRITE=true
HISTORY_MAX_MESSAGES=10

# --- Ingestion ----------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_MB=25
ALLOW_PRIVATE_URLS=false          # SSRF guard for /ingest/url

# --- Storage / backends -------------------------------------------------------
DATA_DIR=./storage                # embedded Chroma dir + checkpoints.sqlite + jobs.sqlite
COLLECTION_NAME=rag_documents
VECTOR_STORE_BACKEND=chroma
# Chroma server mode (shared by all workers/replicas). Unset = embedded (single process).
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_SSL=false
# CHROMA_AUTH_TOKEN=
CHECKPOINTER_BACKEND=sqlite       # sqlite | postgres (uv sync --extra postgres) | memory
# POSTGRES_URL=postgresql://rag:rag@localhost:5432/rag
JOB_STORE_BACKEND=memory          # memory (1 worker) | sqlite (N workers, one host)
BM25_REFRESH_S=2                  # how often each worker checks the store revision

# --- API ----------------------------------------------------------------------
# API_KEY=change-me               # when set, all endpoints except /health need X-API-Key
API_KEY_HEADER=X-API-Key
LOG_LEVEL=INFO
LOG_JSON=true
ENVIRONMENT=dev
# CORS_ORIGINS=["http://localhost:3000"]
